# Environment switch: local | cloud
APP_ENV=local

# CORS (comma-separated). For cloud behind nginx, can be empty.
CORS_ORIGINS=http://localhost:5173

# Upload limits
MAX_UPLOAD_MB=50

# Shared temp folder (host path differs local vs cloud)
COMPARE_DIR=./compare_data

# Redis + queue
REDIS_URL=redis://redis:6379/0
RQ_QUEUE_NAME=compare-jobs
